<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_invoice_filter_mtr_linked" model="ir.ui.view">
        <field name="name">account.move.search.mtr.linked</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='groupby']" position="inside">
                <filter name="group_company" string="Group Company"
                        context="{'group_by': 'group_company_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
