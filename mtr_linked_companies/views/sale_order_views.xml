<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sales_order_filter_mtr_linked" model="ir.ui.view">
        <field name="name">sale.order.search.mtr.linked</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='customer']" position="after">
                <filter name="group_company" string="Group Company"
                        context="{'group_by': 'group_company_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
